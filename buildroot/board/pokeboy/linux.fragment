# Pokeboy: panel via fbdev emulation on tilcdc, evdev buttons, ALSA over McASP, no debug bloat.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_FB=y
CONFIG_DRM=y
CONFIG_DRM_TILCDC=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_DAVINCI_MCASP=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_MAX98357A=y
CONFIG_HZ_250=y
CONFIG_PREEMPT=y
