{
  "expo": {
    "name": "Pokeboy",
    "slug": "pokeboy",
    "version": "0.2.2",
    "orientation": "portrait",
    "scheme": "pokeboy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokeboy.app"
    },
    "android": {
      "package": "com.pokeboy.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
