// Trusted browser-side host imports for Pokeboy .gbmod packages.
(() => {
  "use strict";

  const A = Object.freeze({
    enemySelectedMove: 0xccdd,
    aiCount: 0xccdf,
    enemyMoveListIndex: 0xcce2,
    enemyDisabledMoveNumber: 0xccef,
    buffer: 0xcee9,
    enemyMon: 0xcfe5,
    battleMon: 0xd014,
    trainerClass: 0xd031,
    isInBattle: 0xd057,
    enemyStatus1: 0xd067,
    enemyStatus2: 0xd068,
    enemyStatus3: 0xd069,
    enemyNumAttacksLeft: 0xd06f,
    enemyDisabledMove: 0xd072,
    linkState: 0xd12b,
    partyCount: 0xd163,
    partyMons: 0xd16b,
    partyNicks: 0xd2b5,
    enemyPartyCount: 0xd89c,
    enemyMons: 0xd8a4,
    enemyNicks: 0xd9ee,
  });
  const PARTY_LENGTH = 44;
  const DEFAULT_MAX_TIME_TILL_RANDOM_MS = 30000;
  // maxTimeTillRandom: how long a decision request may wait for the endpoint
  // before Battle Link falls back to a uniform random legal action. 0 skips
  // the network entirely and always picks randomly.
  const maxTimeTillRandomMs = () => {
    const value = Number(globalThis.PokeboyRuntime?.battleLinkMaxTimeTillRandomMs);
    return Number.isFinite(value) && value >= 0 ? value : DEFAULT_MAX_TIME_TILL_RANDOM_MS;
  };
  // Decision source: "get" polls the configured HTTPS endpoint from this
  // page; "discord" hands each snapshot to the native host (which runs the
  // phone-hosted Discord bot) and waits for a decision message back. The
  // deadline/random fallback below stays authoritative in both modes.
  const decisionMode = () =>
    globalThis.PokeboyRuntime?.battleLinkMode === "discord" ? "discord" : "get";
  // Host bridge (installed by the embed page). Every call is fire-and-forget:
  // a missing or throwing bridge must never stall the frame-driven decide().
  const host = (method, detail) => {
    try { globalThis.PokeboyBattleLinkHost?.[method]?.(detail); } catch (error) {}
  };
  const ITEM_CODES = Object.freeze({
    fullRestore: [32, 2, 0x10], potion: [33, 3, 0x14],
    superPotion: [34, 4, 0x13], hyperPotion: [35, 5, 0x12],
    fullHeal: [36, 6, 0x34], guardSpec: [37, 7, 0x31],
    xAttack: [38, 8, 0x41], xDefend: [39, 9, 0x42],
    xSpeed: [40, 10, 0x43], xSpecial: [41, 11, 0x44],
  });
  // Per-class AI use counts from TrainerAIPointers (0e:655c); every class
  // not listed uses the generic count of 3. Native TrainerAI lazily writes
  // this into wAICount, but both its callsites are patched out.
  const AI_ITEM_USES = Object.freeze({
    0x18: 2, 0x1b: 1, 0x1d: 1, 0x1f: 2, 0x20: 1, 0x21: 2, 0x22: 5, 0x23: 1,
    0x24: 1, 0x25: 1, 0x26: 2, 0x27: 2, 0x28: 1, 0x2a: 1, 0x2b: 1, 0x2c: 2,
    0x2e: 2, 0x2f: 1,
  });

  // Diagnostics: forwarded by the embed page into opt-in telemetry events so
  // device-side failures are visible without a debugger.
  const modEvent = (event, detail) => {
    try {
      globalThis.PokeboyModEvent?.("battle-link", Object.assign({ event }, detail || {}));
    } catch (error) {}
  };

  let battleId = null;
  let turn = 0;
  let attempt = 0;
  let pending = null;

  const u16 = (memory, address) => (memory.read8(address) << 8) | memory.read8(address + 1);
  const u24 = (memory, address) =>
    (memory.read8(address) << 16) | (memory.read8(address + 1) << 8) | memory.read8(address + 2);
  const bytes = (memory, address, length) =>
    Array.from({ length }, (_, index) => memory.read8(address + index));
  const decodeName = (memory, address, length = 11) => {
    let value = "";
    for (let index = 0; index < length; index += 1) {
      const code = memory.read8(address + index);
      if (code === 0x50) break;
      if (code >= 0x80 && code <= 0x99) value += String.fromCharCode(65 + code - 0x80);
      else if (code >= 0xa0 && code <= 0xb9) value += String.fromCharCode(97 + code - 0xa0);
      else if (code >= 0xf6 && code <= 0xff) value += String.fromCharCode(48 + code - 0xf6);
      else if (code === 0x7f) value += " ";
      else value += "?";
    }
    return value;
  };
  const pp = (value) => ({ current: value & 0x3f, ppUps: value >>> 6 });

  // Internal-order species names (pokered MonsterNames). Trainer parties never
  // get wEnemyMonNicks written (_AddPartyMon only fills nick arrays on the
  // player branch; the on-screen name comes from GetMonName at send-out), so
  // trainer-side names must be derived from the species id, not decoded RAM.
  const SPECIES_NAMES = "RHYDON,KANGASKHAN,NIDORAN♂,CLEFAIRY,SPEAROW,VOLTORB,NIDOKING,SLOWBRO,IVYSAUR,EXEGGUTOR,LICKITUNG,EXEGGCUTE,GRIMER,GENGAR,NIDORAN♀,NIDOQUEEN,CUBONE,RHYHORN,LAPRAS,ARCANINE,MEW,GYARADOS,SHELLDER,TENTACOOL,GASTLY,SCYTHER,STARYU,BLASTOISE,PINSIR,TANGELA,MISSINGNO.,MISSINGNO.,GROWLITHE,ONIX,FEAROW,PIDGEY,SLOWPOKE,KADABRA,GRAVELER,CHANSEY,MACHOKE,MR.MIME,HITMONLEE,HITMONCHAN,ARBOK,PARASECT,PSYDUCK,DROWZEE,GOLEM,MISSINGNO.,MAGMAR,MISSINGNO.,ELECTABUZZ,MAGNETON,KOFFING,MISSINGNO.,MANKEY,SEEL,DIGLETT,TAUROS,MISSINGNO.,MISSINGNO.,MISSINGNO.,FARFETCH'D,VENONAT,DRAGONITE,MISSINGNO.,MISSINGNO.,MISSINGNO.,DODUO,POLIWAG,JYNX,MOLTRES,ARTICUNO,ZAPDOS,DITTO,MEOWTH,KRABBY,MISSINGNO.,MISSINGNO.,MISSINGNO.,VULPIX,NINETALES,PIKACHU,RAICHU,MISSINGNO.,MISSINGNO.,DRATINI,DRAGONAIR,KABUTO,KABUTOPS,HORSEA,SEADRA,MISSINGNO.,MISSINGNO.,SANDSHREW,SANDSLASH,OMANYTE,OMASTAR,JIGGLYPUFF,WIGGLYTUFF,EEVEE,FLAREON,JOLTEON,VAPOREON,MACHOP,ZUBAT,EKANS,PARAS,POLIWHIRL,POLIWRATH,WEEDLE,KAKUNA,BEEDRILL,MISSINGNO.,DODRIO,PRIMEAPE,DUGTRIO,VENOMOTH,DEWGONG,MISSINGNO.,MISSINGNO.,CATERPIE,METAPOD,BUTTERFREE,MACHAMP,MISSINGNO.,GOLDUCK,HYPNO,GOLBAT,MEWTWO,SNORLAX,MAGIKARP,MISSINGNO.,MISSINGNO.,MUK,MISSINGNO.,KINGLER,CLOYSTER,MISSINGNO.,ELECTRODE,CLEFABLE,WEEZING,PERSIAN,MAROWAK,MISSINGNO.,HAUNTER,ABRA,ALAKAZAM,PIDGEOTTO,PIDGEOT,STARMIE,BULBASAUR,VENUSAUR,TENTACRUEL,MISSINGNO.,GOLDEEN,SEAKING,MISSINGNO.,MISSINGNO.,MISSINGNO.,MISSINGNO.,PONYTA,RAPIDASH,RATTATA,RATICATE,NIDORINO,NIDORINA,GEODUDE,PORYGON,AERODACTYL,MISSINGNO.,MAGNEMITE,MISSINGNO.,MISSINGNO.,CHARMANDER,SQUIRTLE,CHARMELEON,WARTORTLE,CHARIZARD,MISSINGNO.,MISSINGNO.,MISSINGNO.,MISSINGNO.,ODDISH,GLOOM,VILEPLUME,BELLSPROUT,WEEPINBELL,VICTREEBEL".split(",");
  const asSpecies = (mon) => ({ ...mon, nickname: SPECIES_NAMES[mon.species - 1] || `#${mon.species}` });

  function partyMon(memory, base, nicknameBase, slot) {
    const address = base + slot * PARTY_LENGTH;
    return {
      slot,
      species: memory.read8(address),
      nickname: decodeName(memory, nicknameBase + slot * 11),
      hp: u16(memory, address + 1),
      maxHp: u16(memory, address + 34),
      level: memory.read8(address + 33),
      status: memory.read8(address + 4),
      types: bytes(memory, address + 5, 2),
      moves: bytes(memory, address + 8, 4).map((move, index) => ({
        slot: index, move, ...pp(memory.read8(address + 29 + index)),
      })),
      dvs: bytes(memory, address + 27, 2),
      experience: u24(memory, address + 14),
      statExperience: {
        hp: u16(memory, address + 17), attack: u16(memory, address + 19),
        defense: u16(memory, address + 21), speed: u16(memory, address + 23),
        special: u16(memory, address + 25),
      },
      stats: {
        attack: u16(memory, address + 36), defense: u16(memory, address + 38),
        speed: u16(memory, address + 40), special: u16(memory, address + 42),
      },
    };
  }

  function activeMon(memory, address, nicknameAddress) {
    return {
      species: memory.read8(address), nickname: decodeName(memory, nicknameAddress),
      hp: u16(memory, address + 1), partySlot: memory.read8(address + 3),
      status: memory.read8(address + 4), types: bytes(memory, address + 5, 2),
      moves: bytes(memory, address + 8, 4).map((move, index) => ({
        slot: index, move, ...pp(memory.read8(address + 25 + index)),
      })),
      dvs: bytes(memory, address + 12, 2), level: memory.read8(address + 14),
      maxHp: u16(memory, address + 15),
      stats: {
        attack: u16(memory, address + 17), defense: u16(memory, address + 19),
        speed: u16(memory, address + 21), special: u16(memory, address + 23),
      },
    };
  }

  function itemAction(name) {
    const [code, kind, item] = ITEM_CODES[name];
    return { code, type: "item", item, itemName: name, target: "active", _kind: kind };
  }

  function legalActions(memory, trainerParty, trainerActive) {
    const actions = [];
    // wEnemyDisabledMove keeps the disabled move's number (1-4) in the high
    // nibble and the turns left in the low nibble; wEnemyDisabledMoveNumber
    // is the move ID, not a slot.
    const disabled = memory.read8(A.enemyDisabledMove) >> 4;
    trainerActive.moves.forEach((move) => {
      if (move.move && move.current && disabled !== move.slot + 1) {
        actions.push({ code: move.slot, type: "move", ...move, _kind: 0 });
      }
    });
    if (!actions.length) {
      actions.push({ code: 0, type: "move", slot: -1, move: 165, struggle: true, _kind: 0 });
    }

    // Switching is a remote-player right, not an AI behaviour: any healthy
    // benched mon is legal for every trainer class, even with aiCount at 0
    // (aiCount only meters item uses below).
    trainerParty.forEach((mon) => {
      if (mon.hp > 0 && mon.slot !== trainerActive.partySlot) {
        actions.push({ code: 16 + mon.slot, type: "switch", partySlot: mon.slot, _kind: 1 });
      }
    });
    if (memory.read8(A.aiCount) === 0) return actions;
    const trainerClass = memory.read8(A.trainerClass);
    const hp = trainerActive.hp;
    const max = Math.max(1, trainerActive.maxHp);
    const add = (name, condition = true) => { if (condition) actions.push(itemAction(name)); };
    if (trainerClass === 0x18 || trainerClass === 0x1f || trainerClass === 0x26) add("xAttack");
    if (trainerClass === 0x1d) add("guardSpec");
    if (trainerClass === 0x21 || trainerClass === 0x23) add("xDefend");
    if (trainerClass === 0x22) add("fullHeal", trainerActive.status !== 0);
    if (trainerClass === 0x24) add("xSpeed");
    if (trainerClass === 0x20) add("hyperPotion", hp * 10 < max);
    if (trainerClass === 0x25 || trainerClass === 0x28) add("superPotion", hp * 10 < max);
    if (trainerClass === 0x27) add("superPotion");
    if (trainerClass === 0x2a) add("potion", hp * 5 < max);
    if (trainerClass === 0x2b) add("fullRestore", hp * 5 < max);
    if (trainerClass === 0x2c) add("superPotion", hp * 5 < max);
    if (trainerClass === 0x2e) add("superPotion", hp * 4 < max);
    if (trainerClass === 0x2f) add("hyperPotion", hp * 5 < max);
    return actions;
  }

  function newId() {
    if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();
    const data = new Uint8Array(16);
    globalThis.crypto.getRandomValues(data);
    data[6] = (data[6] & 15) | 64;
    data[8] = (data[8] & 63) | 128;
    return Array.from(data, (value) => value.toString(16).padStart(2, "0")).join("");
  }

  function makeSnapshot(memory) {
    const enemyCount = Math.min(6, memory.read8(A.enemyPartyCount));
    const playerCount = Math.min(6, memory.read8(A.partyCount));
    const trainerParty = Array.from({ length: enemyCount }, (_, slot) =>
      asSpecies(partyMon(memory, A.enemyMons, A.enemyNicks, slot)));
    const trainerActive = asSpecies(activeMon(memory, A.enemyMon, A.enemyNicks + memory.read8(A.enemyMon + 3) * 11));
    const opponentParty = Array.from({ length: playerCount }, (_, slot) =>
      partyMon(memory, A.partyMons, A.partyNicks, slot));
    const opponentActive = activeMon(memory, A.battleMon, A.partyNicks + memory.read8(A.battleMon + 3) * 11);
    const actions = legalActions(memory, trainerParty, trainerActive);
    return {
      snapshot: {
        protocol: 1, battleId: battleId || (battleId = newId()), turn, attempt,
        timeoutMs: maxTimeTillRandomMs(), rom: "pokemon-red-us", mod: "battle-link@1.2.0",
        trainer: { class: memory.read8(A.trainerClass), party: trainerParty, active: trainerActive },
        opponent: { party: opponentParty, active: opponentActive },
        battle: {
          enemyBattleStatus: bytes(memory, A.enemyStatus1, 3),
          enemyDisabledMove: memory.read8(A.enemyDisabledMove),
          enemyDisabledMoveNumber: memory.read8(A.enemyDisabledMoveNumber),
          enemyNumAttacksLeft: memory.read8(A.enemyNumAttacksLeft),
          aiUsesRemaining: memory.read8(A.aiCount),
        },
        legalActions: actions.map(({ _kind, ...action }) => action),
      },
      actions,
    };
  }

  const base64url = (value) => {
    const encoded = new TextEncoder().encode(JSON.stringify(value));
    let binary = "";
    for (let index = 0; index < encoded.length; index += 0x4000) {
      binary += String.fromCharCode(...encoded.subarray(index, index + 0x4000));
    }
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  };

  function randomAction(actions) {
    const values = new Uint32Array(1);
    globalThis.crypto.getRandomValues(values);
    return actions[values[0] % actions.length];
  }

  async function requestDecision(state) {
    const timeoutMs = state.snapshot.timeoutMs;
    const deadline = Date.now() + timeoutMs;
    if (decisionMode() === "discord") {
      host("request", state.snapshot);
      while (!state.cancelled && !state.result && Date.now() < deadline) {
        await new Promise((resolve) =>
          setTimeout(resolve, Math.min(250, Math.max(1, deadline - Date.now()))));
      }
      if (!state.cancelled && !state.result) {
        state.result = randomAction(state.actions);
        state.resultSource = "random-deadline";
        modEvent("resolved", { code: state.result.code, source: "random-deadline" });
      }
      return;
    }
    const endpoint = String(globalThis.PokeboyRuntime?.battleLinkEndpoint || "").trim();
    let delay = 250;
    const timeout = setTimeout(() => state.controller.abort("deadline"), timeoutMs);
    try {
      if (!/^https:\/\//i.test(endpoint)) {
        modEvent("config-error", { endpoint });
        throw new Error("Battle Link endpoint is not configured");
      }
      while (!state.cancelled && Date.now() < deadline) {
        try {
          const url = new URL(endpoint);
          url.searchParams.set("state", base64url(state.snapshot));
          modEvent("fetch-start", { attempt: state.snapshot.attempt, urlLength: url.toString().length });
          const response = await fetch(url.toString(), { method: "GET", signal: state.controller.signal });
          // 204 is the long-poll cycling upstream, not an answer — reopen it
          // immediately with no backoff.
          if (response.status === 204) continue;
          let body = null;
          if (response.ok) {
            try { body = await response.json(); } catch (error) { body = null; }
          }
          const action = Number.isInteger(body?.action)
            ? state.actions.find((candidate) => candidate.code === body.action)
            : null;
          if (!action) {
            // The endpoint completed a response but it isn't a legal
            // decision (error status, bad JSON, illegal code): reject the
            // turn with a random legal action instead of retrying.
            state.result = randomAction(state.actions);
            state.resultSource = "random-invalid";
            modEvent("resolved", { code: state.result.code, source: "random-invalid", status: response.status });
            return;
          }
          state.result = action;
          state.resultSource = "remote";
          modEvent("resolved", { code: action.code, source: "remote" });
          return;
        } catch (error) {
          modEvent("fetch-error", { message: String(error) });
          if (state.cancelled || state.controller.signal.aborted) break;
          await new Promise((resolve) => setTimeout(resolve, Math.min(delay, deadline - Date.now())));
          delay = Math.min(delay * 2, 2000);
        }
      }
    } catch (error) {
      // Missing/invalid configuration follows the same deterministic deadline
      // contract as a network failure, while still allowing battle resets.
      while (!state.cancelled && Date.now() < deadline) {
        await new Promise((resolve) => setTimeout(resolve, Math.min(250, deadline - Date.now())));
      }
    } finally {
      clearTimeout(timeout);
      if (!state.cancelled && !state.result) {
        state.result = randomAction(state.actions);
        state.resultSource = "random-deadline";
        modEvent("resolved", { code: state.result.code, source: "random-deadline" });
      }
    }
  }

  function forcedAction(memory) {
    const status1 = memory.read8(A.enemyStatus1);
    const status2 = memory.read8(A.enemyStatus2);
    const status = memory.read8(A.enemyMon + 4);
    return Boolean((status1 & 0x33) || (status2 & 0x60) || (status & 0x27));
  }

  function cancelPending(reason) {
    if (!pending) return;
    pending.cancelled = true;
    pending.controller.abort(reason);
    if (decisionMode() === "discord") {
      const { battleId: id, turn: t, attempt: n } = pending.snapshot;
      host("cancel", { battleId: id, turn: t, attempt: n, reason });
    }
  }

  // Discord mode auto-disconnect: decide() only runs on ROM traps, so battle
  // end (no further decisions) would otherwise go unnoticed. The memory
  // closure handed to host imports stays valid between traps, letting a 1 Hz
  // watch report when the trainer battle is over.
  let battleWatch = 0;
  let battleWatchId = null;
  function stopBattleWatch() {
    if (battleWatch) { clearTimeout(battleWatch); battleWatch = 0; battleWatchId = null; }
  }
  function endWatchedBattle(reason) {
    const id = battleWatchId;
    stopBattleWatch();
    host("battleEnd", { battleId: id, reason });
  }
  function startBattleWatch(memory) {
    if (battleWatch) return;
    battleWatchId = battleId;
    const tick = () => {
      battleWatch = 0;
      if (memory.read8(A.isInBattle) === 2) {
        battleWatch = setTimeout(tick, 1000);
        return;
      }
      endWatchedBattle("battle-over");
    };
    battleWatch = setTimeout(tick, 1000);
  }

  function resetBattle() {
    cancelPending("battle-reset");
    if (battleWatch) endWatchedBattle("battle-reset");
    battleId = newId();
    turn = 0;
    attempt = 0;
    pending = null;
  }

  globalThis.PokeboyBattleLinkDeliver = (message) => {
    const state = pending;
    if (!state || state.cancelled || state.result) return false;
    if (!message
      || message.battleId !== state.snapshot.battleId
      || message.turn !== state.snapshot.turn
      || message.attempt !== state.snapshot.attempt) return false;
    if (!Number.isInteger(message.action)) return false;
    const action = state.actions.find((candidate) => candidate.code === message.action);
    if (!action) {
      modEvent("discord-illegal-action", { action: message.action });
      return false;
    }
    state.result = action;
    state.resultSource = "discord";
    modEvent("resolved", { code: action.code, source: "discord" });
    return true;
  };

  function decide(cpu, memory) {
    if (cpu.a === 4) {
      resetBattle();
      cpu.a = 0;
      return;
    }
    if (memory.read8(A.isInBattle) !== 2 || memory.read8(A.linkState) !== 0 || forcedAction(memory)) {
      if (pending) { cancelPending("native-action"); pending = null; }
      memory.write8(A.buffer, 0);
      cpu.a = 3;
      return;
    }
    // B backs out of a wait while the turn is still open (the ROM only sets
    // this flag then): abort the in-flight request and advance the attempt
    // so the re-entered turn opens a fresh one.
    if (memory.read8(A.buffer + 2)) {
      if (pending) cancelPending("player-cancelled");
      pending = null;
      attempt += 1;
      cpu.a = 2;
      return;
    }
    if (!pending) {
      // Native TrainerAI lazily seeded wAICount from the per-class table
      // ($ff sentinel, reset on every send-out); with its callsites patched
      // out, seed it here or trainers keep 255 item uses.
      if (memory.read8(A.aiCount) === 0xff) {
        memory.write8(A.aiCount, AI_ITEM_USES[memory.read8(A.trainerClass)] ?? 3);
      }
      const { snapshot, actions } = makeSnapshot(memory);
      pending = {
        snapshot, actions, controller: new AbortController(), cancelled: false, result: null,
        resultSource: null, deadline: Date.now() + snapshot.timeoutMs,
      };
      if (decisionMode() === "discord") startBattleWatch(memory);
      requestDecision(pending);
    }
    if (!pending.result) {
      if (Date.now() < pending.deadline) {
        // The AWAITING dialog is drawn by the .gbmod itself
        // (BattleLinkDrawWaiting) so UI changes ship via the registry.
        cpu.a = 0;
        return;
      }
      // Frame-driven failsafe: this hook runs every frame while the ROM
      // waits, so the deadline holds even if the async request path never
      // settles (wedged fetch or timers in the WebView).
      pending.cancelled = true;
      pending.controller.abort("deadline");
      pending.result = randomAction(pending.actions);
      pending.resultSource = "random-failsafe";
      modEvent("resolved", { code: pending.result.code, source: "random-failsafe" });
    }
    const action = pending.result;
    const source = pending.resultSource || "unknown";
    memory.write8(A.buffer, action._kind);
    if (action.type === "move") {
      memory.write8(A.enemyMoveListIndex, Math.max(0, action.slot));
      memory.write8(A.enemySelectedMove, action.move);
      memory.write8(A.buffer + 1, Math.max(0, action.slot));
    } else if (action.type === "switch") {
      memory.write8(A.buffer + 1, action.partySlot);
    } else {
      memory.write8(A.buffer + 1, action.item);
    }
    if (decisionMode() === "discord") {
      const { battleId: id, turn: t, attempt: n } = pending.snapshot;
      host("resolved", {
        battleId: id, turn: t, attempt: n,
        code: action.code, source,
      });
    }
    pending = null;
    turn += 1;
    attempt = 0;
    // 1 tells the ROM a decision landed (RECEIVED); 4 marks a random
    // fallback (REJECTED). Needs package >= 1.1.0 — the registry ships the
    // package ahead of any app build carrying this file, and the new package
    // with an older host simply never sees a 4.
    cpu.a = source.startsWith("random") ? 4 : 1;
  }

  globalThis.PokeboyModCore = Object.freeze({ "battle-link.decide": decide });
})();
