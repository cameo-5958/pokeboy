node_modules/
dist/
.env

# Issued device API keys — secrets, never commit.
data/keys.json

# Web player persistence (battery saves, save states).
data/web/

# ROM binaries and user-supplied mod payloads are never committed.
# ROM symbol documents (.sym) are fine to track — they contain no ROM data.
roms/*.gb
roms/*.gbc
roms/*.rom
mods/*
!roms/.gitkeep
!mods/.gitkeep
!mods/*.sym
